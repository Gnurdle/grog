#!/usr/bin/env bash
# grog-ui — launch the grog Swing GUI (chat window + home-spawned terminal).
#
# Usage:   ./grog-ui [args]
# Needs:   the Clojure CLI and a desktop session.
set -euo pipefail

cd "$(dirname "$0")"

# Resolve a Clojure CLI explicitly. Desktop launchers (KDE/GNOME .desktop) hand
# the process a minimal PATH, so don't rely on the ambient PATH alone.
if [ -x "$HOME/.clojure-cli/bin/clojure" ]; then
  CLJ="$HOME/.clojure-cli/bin/clojure"
elif command -v clojure >/dev/null 2>&1; then
  CLJ="$(command -v clojure)"
else
  echo "grog-ui: the 'clojure' command line tool was not found." >&2
  echo "         Install it via https://clojure.org/guides/install_clojure" >&2
  exit 1
fi

export HOME="${HOME:-$(getent passwd "$(id -u)" | cut -d: -f6)}"
# Repo root, exported so the app can find icon.png/logo.jpg regardless of the
# process's CWD (desktop launchers often start with a different working dir).
export GROG_HOME="$(pwd -P)"

# The LLM API key is read from the OS keyring (LLM_API_KEY) as a fallback, so
# desktop launches don't depend on a shell rc exporting it.

# --- log management ---------------------------------------------------------
# grog-ui always writes to a single current log file ($GROG_LOG or
# $HOME/grog-ui.log). On each launch the previous log is rotated: capped to
# the last MAX_LOG bytes, renamed to <base>.<next>, and only the newest
# $GROG_UI_LOG_KEEP rotations are kept (older ones removed).
if [ -n "${GROG_LOG:-}" ]; then
  LOG_BASE="$GROG_LOG"
else
  LOG_BASE="$HOME/grog-ui.log"
fi
MAX_LOG="${GROG_UI_LOG_MAX:-5242880}"
KEEP="${GROG_UI_LOG_KEEP:-5}"
LOG="$LOG_BASE"
export GROG_LOG="$LOG"

# rotate the previous log (best effort, only on launch)
if [ -f "$LOG_BASE" ]; then
  # keep the newest ~MAX_LOG bytes of the current log
  size=$(wc -c < "$LOG_BASE" 2>/dev/null || echo 0)
  size=${size// /}
  if [ "$size" -gt "$MAX_LOG" ]; then
    tmp="$LOG_BASE.tmp"
    tail -c "$MAX_LOG" "$LOG_BASE" > "$tmp" 2>/dev/null || rm -f "$tmp"
    [ -f "$tmp" ] && mv -f "$tmp" "$LOG_BASE"
  fi
  # next available rotation number
  next=1
  for rot in "$LOG_BASE".*; do
    [ -e "$rot" ] || continue
    n="${rot##*.}"
    case "$n" in
      ''|*[!0-9]*) continue ;;
    esac
    [ "$n" -ge "$next" ] && next=$((n + 1))
  done
  mv -f "$LOG_BASE" "$LOG_BASE.$next" 2>/dev/null || true
  # keep only the newest $KEEP rotations
  while [ "$(find "$(dirname "$LOG_BASE")" -maxdepth 1 -name "$(basename "$LOG_BASE").[0-9]*" 2>/dev/null | wc -l)" -gt "$KEEP" ]; do
    oldest=""
    for rot in "$LOG_BASE".*; do
      [ -e "$rot" ] || continue
      n="${rot##*.}"
      case "$n" in
        ''|*[!0-9]*) continue ;;
      esac
      if [ -z "$oldest" ] || [ "$n" -lt "${oldest##*.}" ]; then
        oldest="$rot"
      fi
    done
    [ -n "$oldest" ] && rm -f "$oldest" 2>/dev/null || break
  done
fi

echo "=== grog-ui launch: $(date '+%F %T') clj=$CLJ$$ ===" >> "$LOG"

exec 3>&2
"$CLJ" -M:gui "$@" > >(tee -a "$LOG") 2> >(tee -a "$LOG" >&3)
