{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/data.json {:mvn/version "2.5.1"}
        ;; Office document manipulation (docx) — pixel-preserving edits.
        ;; poi-ooxml-full provides the complete OOXML schema (incl. CTTc etc.);
        ;; the default poi-ooxml-lite omits rarely-used classes and breaks reflection.
        org.apache.poi/poi-ooxml {:mvn/version "5.3.0" :exclusions [org.apache.poi/poi-ooxml-lite]}
        org.apache.poi/poi-ooxml-full {:mvn/version "5.3.0"}
        io.modelcontextprotocol.sdk/mcp {:mvn/version "0.8.0"}
        org.slf4j/slf4j-nop {:mvn/version "2.0.3"}}
 :aliases
 {:mcp {:main-opts ["-m" "grog-office.main"]}}}
