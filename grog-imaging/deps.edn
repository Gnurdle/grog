{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/data.json {:mvn/version "2.5.0"}
        cheshire/cheshire {:mvn/version "5.13.0"}
        clj-http/clj-http {:mvn/version "3.13.0"}
        ;; imaging / document toolchain (moved from grog/src/grog deps.edn)
        org.apache.poi/poi-ooxml {:mvn/version "5.3.0"}
        org.apache.pdfbox/pdfbox {:mvn/version "3.0.4"}
        net.sourceforge.tess4j/tess4j {:mvn/version "5.14.0"}
        org.boofcv/boofcv-io {:mvn/version "1.2.2"}
        org.boofcv/boofcv-feature {:mvn/version "1.2.2"}
        io.modelcontextprotocol.sdk/mcp {:mvn/version "0.8.0"}
        org.slf4j/slf4j-nop {:mvn/version "2.0.3"}}
 :aliases
 {:mcp {:main-opts ["-m" "grog-imaging.main"]
        ;; heavy native / reflective deps (Tesseract, JLine-style)
        :jvm-opts ["--add-opens=java.base/java.lang=ALL-UNNAMED"
                   "--enable-native-access=ALL-UNNAMED"]}}}
