{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/data.json {:mvn/version "2.5.1"}
        clj-http/clj-http {:mvn/version "3.13.0"}
        io.modelcontextprotocol.sdk/mcp {:mvn/version "0.8.0"}
        ;; the token is read from the OS keyring (like grog-search's Brave key),
        ;; NOT injected as an env var — an env var lands in the generated ECA
        ;; config file, i.e. the token would sit on disk
        com.github.javakeyring/java-keyring {:mvn/version "1.0.4"}
        org.slf4j/slf4j-nop {:mvn/version "2.0.3"}}
 :aliases
 {:mcp {:main-opts ["-m" "grog-gitlab.main"]}}}