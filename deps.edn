{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        clj-http/clj-http {:mvn/version "3.13.0"}
        cheshire/cheshire {:mvn/version "5.13.0"}
        org.jline/jline {:mvn/version "3.29.0"}
        org.commonmark/commonmark {:mvn/version "0.21.0"}
        org.commonmark/commonmark-ext-gfm-tables {:mvn/version "0.21.0"}
        org.apache.poi/poi-ooxml {:mvn/version "5.3.0"}
        org.apache.pdfbox/pdfbox {:mvn/version "3.0.4"}
        ;; PDF OCR (image / scanned pages); needs native Tesseract + tessdata on the host
        net.sourceforge.tess4j/tess4j {:mvn/version "5.14.0"}
        ;; https://github.com/lessthanoptimal/BoofCV — line segments on rasterized PDFs (with ocr_pdf_document)
        org.boofcv/boofcv-io {:mvn/version "1.2.2"}
        org.boofcv/boofcv-feature {:mvn/version "1.2.2"}
        ;; macOS Keychain / Windows Credential Manager / Linux Secret Service (GNOME/KDE)
        com.github.javakeyring/java-keyring {:mvn/version "1.0.4"}
        ;; associative-memory tools backed by a local SQLite file (java.sql / JDBC DriverManager)
        org.xerial/sqlite-jdbc {:mvn/version "3.45.1.0"}
        org.slf4j/slf4j-nop {:mvn/version "2.0.9"}
        ;; modern flat Look & Feel so the chat + shell windows share a theme
        com.formdev/flatlaf {:mvn/version "3.7.2"}
        ;; real terminal (JediTerm widget) + PTY for the GUI shell window.
        org.jetbrains.pty4j/pty4j {:mvn/version "0.13.12"}
        com.github.JetBrains.JediTerm/jediterm-core {:mvn/version "master-86b5bea5f6-1"}
        com.github.JetBrains.JediTerm/jediterm-ui {:mvn/version "master-86b5bea5f6-1"}}
  :mvn/repos {"jitpack" {:url "https://jitpack.io"}}

 :aliases
 {:run {:main-opts ["-m" "grog.core"]
       ;; JDK 21+: native / reflective access for some transitive deps (e.g. JLine, OCR)
       :jvm-opts ["--add-opens=java.base/java.lang=ALL-UNNAMED"
                  "--enable-native-access=ALL-UNNAMED"]}
  ;; Shorthand: `clojure -M:gui` → GUI (or `./grog-ui`); headless one-shot via `-m grog.core <text>`
  :gui {:main-opts ["-m" "grog.ui"]
        :jvm-opts ["--add-opens=java.base/java.lang=ALL-UNNAMED"
                   "--enable-native-access=ALL-UNNAMED"
                   "-Dlog4j2.statusLoggerLevel=OFF"
                   "-Dlog4j2.disableJmx=true"
                   ;; faster cold start from a desktop launcher: stop deep JIT
                   "-XX:TieredStopAtLevel=1"
                   ;; Windows: skip the Direct3D (GPU) rendering pipeline. On
                   ;; Windows, Swing's D3D-accelerated surface can paint custom
                   ;; panes (like the prompt box) as a blank/white box on the
                   ;; physical screen even though the logical/software render is
                   ;; correct (PrintWindow shows the right colors). Disabling D3D
                   ;; routes rendering through the OS software pipeline, which
                   ;; paints deterministically. (Linux uses XRender/GL and is
                   ;; unaffected — this is why the bug only appears on Windows.)
                   "-Dsun.java2d.d3d=false"
                   "-Dsun.java2d.noddraw=true"
                   "-Dsun.java2d.opengl=false"]}
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.13"}}
          :ns-default build}
  :eca-test {:main-opts ["-m" "grog.eca-test"]}
  :jline-native {:jvm-opts ["--enable-native-access=ALL-UNNAMED"]}}}
