{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        ;; portable filesystem helpers (pure Clojure, JVM + bb) — used for
        ;; per-instance log management so no shell/PowerShell is needed
        babashka/fs {:mvn/version "0.5.34"}
        clj-http/clj-http {:mvn/version "3.13.0"}
        cheshire/cheshire {:mvn/version "5.13.0"}
        org.jline/jline {:mvn/version "3.29.0"}
        org.commonmark/commonmark {:mvn/version "0.21.0"}
        org.commonmark/commonmark-ext-gfm-tables {:mvn/version "0.21.0"}
        org.apache.poi/poi-ooxml {:mvn/version "5.3.0"}
        org.apache.pdfbox/pdfbox {:mvn/version "3.0.4"}
        ;; PDF OCR (image / scanned pages); needs native Tesseract + tessdata on the host
        net.sourceforge.tess4j/tess4j {:mvn/version "5.14.0"}
        ;; https://github.com/lessthanoptimal/BoofCV — line segments on rasterized PDFs (with ocr_pdf_document)
        org.boofcv/boofcv-io {:mvn/version "1.2.2"}
        org.boofcv/boofcv-feature {:mvn/version "1.2.2"}
        ;; macOS Keychain / Windows Credential Manager / Linux Secret Service (GNOME/KDE)
        com.github.javakeyring/java-keyring {:mvn/version "1.0.4"}
        ;; associative-memory tools backed by a local SQLite file (java.sql / JDBC DriverManager)
        org.xerial/sqlite-jdbc {:mvn/version "3.45.1.0"}
        org.slf4j/slf4j-nop {:mvn/version "2.0.9"}}

 :aliases
 {:run {:main-opts ["-m" "grog.core"]
       ;; JDK 21+: native / reflective access for some transitive deps (e.g. JLine, OCR)
       :jvm-opts ["--add-opens=java.base/java.lang=ALL-UNNAMED"
                  "--enable-native-access=ALL-UNNAMED"]}
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.13"}}
          :ns-default build}
  :eca-test {:main-opts ["-m" "grog.eca-test"]}
  :jline-native {:jvm-opts ["--enable-native-access=ALL-UNNAMED"]}
  ;; GraalVM native-image for the backend (grog.server). `graal-build-time`
  ;; makes Clojure classes initialize at build time so the image doesn't do the
  ;; whole runtime boot per launch. See scripts/native-image.sh.
  :native {:extra-deps {com.github.clj-easy/graal-build-time {:mvn/version "1.0.6"}}}}}
