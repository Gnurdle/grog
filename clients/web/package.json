{ "name": "grog-web"
, "version": "0.0.1"
, "private": true
, "description": "grog web/Electron client — P0 skeleton (see doc/clients/web-client-plan.md)"
, "main": "src/main/main.js"
, "scripts":
  { "css": "tailwindcss -i resources/public/css/input.css -o resources/public/css/output.css --watch"
  , "cljs": "shadow-cljs watch app"
  , "electron": "electron ."
  , "dev": "concurrently -k \"npm:cljs\" \"npm:css\" \"wait-on tcp:9633 http://localhost:9633/js/main.js && npm run electron\""
  , "build": "shadow-cljs release app && tailwindcss -i resources/public/css/input.css -o resources/public/css/output.css --minify"
  , "start": "NODE_ENV=production electron ."
  , "prod": "npm run build && npm start"
  , "dist": "electron-builder --publish never"
  }
, "build":
  { "appId": "dev.grog.client"
  , "productName": "grog"
  , "files": ["src/**/*", "resources/**/*", "package.json"]
  , "extraResources":
    [ { "from": "../../target/grog-spine.jar", "to": "jars/grog-spine.jar" }
    , { "from": "../../grog_mcp/target", "to": "jars", "filter": ["grog-mcp-*.jar"] }
    , { "from": "../../scripts/prereqs.ps1", "to": "setup/prereqs.ps1" }
    ]
  , "icon": "build/icon"
  , "win": { "target": ["nsis"], "icon": "build/icon.ico"
           , "artifactName": "grog-${version}-setup.${ext}" }
  , "nsis":
    { "oneClick": false
    , "perMachine": false
    , "allowToChangeInstallationDirectory": true
    , "createDesktopShortcut": true
    , "createStartMenuShortcut": true
    , "shortcutName": "grog"
    , "include": "build/installer.nsh"
    }
  , "linux":
    { "target": ["AppImage", "tar.gz"]
    , "icon": "build/icon.png"
    , "category": "Development"
    , "artifactName": "grog-${version}-${arch}.${ext}"
    , "desktop": { "Name": "grog", "StartupWMClass": "grog" }
    }
  }
, "devDependencies":
  { "electron": "31.7.7"
  , "electron-builder": "25.1.8"
  , "shadow-cljs": "2.28.19"
  , "tailwindcss": "3.4.17"
  , "postcss": "8.4.47"
  , "autoprefixer": "10.4.20"
  , "concurrently": "9.0.1"
  , "wait-on": "8.0.1"
  }
, "dependencies": { "react": "18.3.1", "react-dom": "18.3.1" }
}