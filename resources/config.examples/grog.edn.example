;; grog.edn — copy to ~/.config/grog/grog.edn  ($GROG_CONFIG_HOME overrides).
;; Every key is optional; grog runs on built-in defaults without this file.

{:llm {:url   "https://openrouter.ai/api/v1"   ; OpenAI-compatible endpoint
       :model "moonshotai/kimi-k3"             ; THE model: chat + grog's own calls
       ;; There is NO :api-key field. A key NEVER lives in a config file — it goes
       ;; in the OS keyring once:  /secret set LLM_API_KEY sk-or-v1-…
       ;; :profiles is grog's PROVIDER CATALOGUE — named alternate endpoints.
       ;; Select one with /model or the settings provider picker. The full,
       ;; machine-readable list is resources/providers.edn; every URL below is an
       ;; EXACT OpenAI-compatible base (grog appends /models and /chat/completions
       ;; — several do not end in /v1). Keys stay in the keyring, never here.
       :profiles
       {;; remote — one API key each; store it once with `/secret set <KEY> …`
        :openrouter {:url "https://openrouter.ai/api/v1"                               :model "moonshotai/kimi-k3"}
        :fireworks  {:url "https://api.fireworks.ai/inference/v1"                      :model "accounts/fireworks/models/llama-v3p3-70b-instruct"}
        :groq       {:url "https://api.groq.com/openai/v1"                             :model "llama-3.3-70b-versatile"}
        :together   {:url "https://api.together.xyz/v1"                                :model "meta-llama/Llama-3.3-70B-Instruct-Turbo"}
        :deepseek   {:url "https://api.deepseek.com/v1"                                :model "deepseek-chat"}
        :mistral    {:url "https://api.mistral.ai/v1"                                  :model "mistral-large-latest"}
        :cerebras   {:url "https://api.cerebras.ai/v1"                                 :model "llama-3.3-70b"}
        :xai        {:url "https://api.x.ai/v1"                                        :model "grok-2-latest"}
        :moonshot   {:url "https://api.moonshot.ai/v1"                                 :model "kimi-k2-0905-preview"}
        :zai        {:url "https://api.z.ai/api/paas/v4"                               :model "glm-4.6"}
        :deepinfra  {:url "https://api.deepinfra.com/v1/openai"                        :model "meta-llama/Meta-Llama-3.1-8B-Instruct"}
        :sambanova  {:url "https://api.sambanova.ai/v1"                                :model "Meta-Llama-3.3-70B-Instruct"}
        :nvidia     {:url "https://integrate.api.nvidia.com/v1"                        :model "meta/llama-3.3-70b-instruct"}
        :google     {:url "https://generativelanguage.googleapis.com/v1beta/openai/"   :model "gemini-2.0-flash"}
        :openai     {:url "https://api.openai.com/v1"                                  :model "gpt-4o-mini"}
        :perplexity {:url "https://api.perplexity.ai"                                  :model "sonar"}
        :github     {:url "https://models.inference.ai.azure.com"                      :model "gpt-4o-mini"}
        :novita     {:url "https://api.novita.ai/v3/openai"                            :model "meta-llama/llama-3.3-70b-instruct"}
        :hyperbolic {:url "https://api.hyperbolic.xyz/v1"                              :model "meta-llama/Llama-3.3-70B-Instruct"}
        :reflection {:url "https://api.reflection.ai/openai/v1"                        :model "Beam-501B-A23B"}

        ;; local — no key (run the server yourself). These are DEFAULTS: a local
        ;; server can run on any port, and if you run more than one of a kind
        ;; (two Strata launches) put the port in the url — `http://localhost:8081/v1`
        ;; — or use the Models dialog (its URL field holds the port) or
        ;; `/provider strata 8081`. See USERS-GUIDE §4.6.
        :ollama     {:url "http://localhost:11434/v1"                                  :model "qwen3:8b"}
        :lmstudio   {:url "http://localhost:1234/v1"                                   :model "qwen2.5-7b-instruct"}
        :strata     {:url "http://localhost:8080/v1"                                   :model "qwen3.8-flash-next-unsloth-ud-q4_k_xl"}
        :vllm       {:url "http://localhost:8000/v1"                                   :model "qwen3.8-flash-next-unsloth-ud-q4_k_xl"}
        :litellm    {:url "http://localhost:4000/v1"                                   :model "gpt-4o-mini"}}}   ; a local relay in front of many providers

 ;; MODEL RECENTS (optional) — the shortlist the picker and `/model` offer, newest
 ;; first. Every pick (from the dialog, `/model <n>`, or `/model <name>`) is
 ;; written here, and the least-recently-used entry falls off past the cap. grog
 ;; keeps this up to date for you; it is written down here so you know it exists
 ;; (and can hand-edit or clear it). The provider is derived from :url.
 ;;   :recents [{:url "http://localhost:8080/v1" :model "qwen3.8-flash-next-unsloth-ud-q4_k_xl"}
 ;;             {:url "https://openrouter.ai/api/v1" :model "aion-labs/aion-2.0"}]
 ;;   :recents-max 10                             ; how many to keep

 ;; CONTEXT BUDGET (optional, and NOT how big the model is). grog derives the
 ;; budget per model from the endpoint's own window — it asks /models and /props,
 ;; and if a prompt is still refused it reads the ceiling out of the provider's
 ;; error, remembers it per (url, model) in context-windows.edn, distills the
 ;; conversation and RE-SENDS the same step. Nothing here needs setting for that
 ;; to work, and there is no default to tune.
 ;;   :max-context-tokens 60000                   ; an OVERRIDE that may only LOWER
 ;;                                               ; the budget (to bound spend) —
 ;;                                               ; it cannot raise it past the window

 :babashka {:enabled true}                     ; the run_babashka tool

 :soul   {:path "SOUL.md"}                     ; persona text loaded into prompts
 :skills {:roots ["skills"]}                   ; skill dirs: <root>/<name>/SKILL.md

 :edn-store {:root "edn-store"}                ; memory_* tools, MCP registry, /jobs
 :jobs      {:max-thread-turns 40}             ; dialog turns fed to /jobs + chron

 :chron {:enabled false                        ; scheduled agent tasks
         :tasks [{:id "heartbeat"
                  :every-minutes 60            ; how often it runs
                  :instruction                 ; what the agent should do
                  "Review project memory if useful (memory_namespaces / memory_list_keys / memory_load). If nothing needs attention, one-line OK."}]}

 :voice {:enabled true                         ; push-to-talk mic button
         :command                              ; WAV in ({wav}), text on stdout.
         ;; The DESKTOP client never reads this block: it takes its engine from
         ;; $GROG_VOICE_COMMAND / $GROG_VOICE_MODEL. This is only for the CLI
         ;; (grog.voice) — point it at YOUR whisper.cpp install, engine on PATH
         ;; and model wherever you put it (grog ships neither).
         ["whisper-cli" "-m" "~/whisper.cpp/models/ggml-base.en.bin"
          "-f" "{wav}" "-nt"]
         :sample-rate 16000
         :max-seconds 60}                      ; auto-stop after this long

 :appearance
 {:theme {:name "flat-dark"}                   ; colour preset
  :chat
  {:font-family "Fira Code SemiBold"           ; transcript font
   :font-size   20                             ; transcript size
   :background  {:rgb [0 0 0]}                 ; window background
   :text        {:rgb [216 224 234]}           ; default text
   :user        {:rgb [255 153 102]}           ; your messages
   :thinking    {:rgb [153 153 0]}             ; reasoning traces
   :answer      {:rgb [0 153 153]}             ; assistant replies
   :tool-call   {:rgb [255 0 255]}             ; tool-call lines
   :snark       {:rgb [128 128 140]}           ; startup snark line
   :code-bg     {:rgb [22 30 36]}              ; code blocks
   :bubble-bg   {:rgb [43 44 54]}              ; message bubbles
   :card-bg     {:rgb [26 29 35]}              ; dialogs / cards
   :border      {:rgb [60 66 78]}              ; borders
   :selection   {:rgb [185 205 240]}           ; selected text background
   :selection-fg {:rgb [15 20 28]}}            ; selected text colour
  :terminal
  {:font-family "Fira Code SemiBold"
   :font-size   20
   :foreground  {:rgb [153 255 0]}             ; terminal text
   :background  {:rgb [51 0 51]}}}             ; terminal background

 :cli {:chat-history-turns 96                  ; prior turns kept; 0 = none, omit = all
       :chat-show-thinking true                ; show reasoning traces
       :chat-stream-live-thinking true         ; stream reasoning as it arrives
       :chat-stream-live-content true          ; stream answer tokens (plain-text mode)
       :chat-stream-live-markdown true         ; stream markdown block by block
       :format-markdown true}}                 ; render the answer as ANSI markdown
