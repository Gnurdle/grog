{:eca {:model "openrouter/moonshotai/kimi-k2.6"}
 ;; LLM: any OpenAI-compatible /v1/chat/completions endpoint (Ollama, OpenRouter, OpenAI, etc.)
 ;; For local Ollama use: :url "http://localhost:11434/v1"
 :llm {:url "http://localhost:11434/v1"
       :model "qwen3.5:9b"
       ;; Optional: inline API key (not recommended). Prefer OS keyring account LLM_API_KEY set via /secret.
       ;; :api-key "${LLM_API_KEY}"
       ;; Optional: debug request payload and/or raw response content to stderr.
       ;; :debug-payload true
       ;; :debug-response true
       ;; Optional: token budget. Oldest non-system messages are dropped before each request.
       ;; Rough estimate (~4 chars/token). Default 200000; set to nil to disable.
       ;; :max-context-tokens 200000
       ;; Optional: cap individual tool result length. Default 50000; set to nil to disable.
       ;; :max-tool-result-chars 50000
       ;; Optional: temperature (provider default when omitted).
       ;; :temperature 0.7
       ;; Optional: max output tokens (provider default when omitted).
       ;; :max-tokens 4096
       ;; Optional: connection/read timeouts in seconds (defaults: conn 60, socket 300).
       ;; :conn-timeout-sec 60
       ;; :socket-timeout-sec 300
       ;; Optional: human-readable label for status lines.
       ;; :provider-name "Ollama Local"
       ;; Optional: provider-specific fields merged into every request payload.
       ;; E.g. OpenRouter context compression: :extra-payload {:transforms ["middle-out"]}
       ;; :extra-payload {:transforms ["middle-out"]}
       ;; Optional: named presets for /model. Each profile overrides base :llm keys for the session.
       ;; :profiles {:local  {:url "http://localhost:11434/v1" :model "qwen2.5-coder:7b-instruct" :api-key nil}
       ;;            :remote {:url "https://openrouter.ai/api/v1" :model "moonshotai/kimi-k2.7-code"}}
       }
 :soul {:path "SOUL.md"}
 ;; Skills: each subdir of these roots must contain skill.edn + SKILL.md
 :skills {:roots ["skills"]
          ;; :max-body-chars 65536
          ;; :prompt-skill-lines 16
          }
 ;; Babashka is always enabled (a given) — run_babashka is always exposed to the model.
 ;; The only knob is the `bb` command; override with :command (or env GROG_BABASHKA_CMD).
 :babashka {;; :command "bb"
            }
 ;; Optional: edn-store for memory_* tools, MCP persistence, and /jobs (relative path).
 ;; :edn-store {:root "edn-store"}
 ;; Project home — where per-project context lives, OUTSIDE the source tree.
 ;; Each immediate subdir is a project (GUI picker or /project lists/switches). Default ~/grog-projects.
 ;; A project may hold project.edn with :description, :model, :mcp, :appearance, and :root (an
 ;; absolute/~-expanded path to override the working dir, e.g. point a "grog" project at the repo).
 ;; :projects {:dir "~/grog-projects" :default "gmail-cleanup"}
 ;; Optional: Appearance theming. Edit via the GUI Settings panel or directly.
 ;; :appearance {:chat {:font-family "Monospaced" :font-size 18
 ;;                     :user {:rgb [165 138 25]} :thinking {:rgb [55 165 95]}
 ;;                     :answer {:rgb [100 220 255]} :tool-call {:rgb [255 0 255]}}
 ;;              :terminal {:font-family "Monospaced" :font-size 18}}
 :cli {:verbose-steps false
       ;; Prior user/assistant pairs prepended to each chat message. `0` = stateless (no old replies).
       ;; Omit key = unlimited (grows forever; use /clear or /fresh in chat to reset).
       :chat-history-turns 12
       ;; When true/false: always/never print model `:thinking` in chat (pale green). Omit: only if JVM has a console.
       :chat-show-thinking true
       ;; Streaming options.
       :chat-stream-live-thinking true
       :chat-stream-live-content true
       :chat-stream-live-markdown false
       :format-markdown true}}
